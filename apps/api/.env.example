# Copia este archivo a apps/api/.env  (NUNCA lo subas al repositorio)
# Genera los secretos con:  npm run gen:keys

NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# Origen público de la web. En producción debe ser https://
PUBLIC_ORIGIN=https://hub.fable-denebola.ts.net

# --- Obligatorios en producción ---

# Fichero de datos (mientras no haya base de datos)
DATA_FILE=./data/store.json

# Sirve la web compilada desde la propia API (servidor casero de un solo proceso)
# STATIC_DIR=../web/dist

# true si hay proxy inverso delante (Caddy, Cloudflare Tunnel…)
# TRUST_PROXY=true

# Datos de demostración y cambio de plan sin pago. Por defecto: true en desarrollo, false en producción
# ALLOW_DEMO_DATA=false

# --- Opcionales ---
# Acceso con Google
# GOOGLE_CLIENT_ID=
# Consejos con IA (plan Premium)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Recordatorios push:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu@email.com

# Mientras no haya cobro: todas las cuentas tienen las funciones Premium (lo pone `servidor.sh activar`).
PREMIUM_FOR_ALL=false
# Enlace de descarga del APK de Android (lo pone `servidor.sh apk URL`).
# APK_URL=https://github.com/…/releases/latest/download/econsultor.apk
